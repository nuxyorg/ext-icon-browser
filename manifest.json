{
  "id": "com.nuxy.icon-browser",
  "name": "Icon Browser",
  "version": "1.0.0",
  "type": "tool",
  "category": "developer",
  "icon": "search",
  "permissions": ["network", "clipboard"],
  "capabilities": {
    "callable": false,
    "caller": false
  },
  "entry": {
    "backend": "backend.ts",
    "frontend": "frontend.ts",
    "element": "nuxy-tool-icon-browser"
  },
  "locales": {
    "default": "en",
    "supported": ["en", "tr", "ja"]
  }
}
